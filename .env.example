# PRD Architect — Environment Configuration
# Copy this file to .env and fill in your API keys.

# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCode Zen API Key (https://opencode.ai) — provides free models
OPENCODE_API_KEY=your_opencode_api_key_here

# 9router API Key (https://9router.com) — router/proxy with custom endpoint & models
NINE_ROUTER_API_KEY=your_9router_api_key_here

# Server Configuration
PORT=3000

# Environment mode: 'development' or 'production'. Set to 'production' on deployment.
# Mode lingkungan: 'development' atau 'production'. Wajib diset ke 'production' saat deploy (mis. Render).
NODE_ENV=development

# Izinkan fallback ke API key server jika client tidak menyertakan key sendiri.
# Default: false. Hanya aktifkan (true) untuk self-host / instance privat yang membagikan key bersama.
# JANGAN aktifkan di instance publik untuk mencegah penyalahgunaan kuota API server oleh publik.
#
# Allow server API key fallback when client does not provide their own API key.
# Default: false. Only enable (true) for self-hosted or trusted private instances sharing keys.
# DO NOT enable on public instances to prevent unauthorized consumption of server API quota.
ALLOW_SERVER_KEY_FALLBACK=false

# Izinkan custom endpoint ke alamat privat/loopback (mis. proxy LLM lokal
# http://localhost:20128/v1/chat/completions). Otomatis aktif bila
# NODE_ENV != production. JANGAN aktifkan di deployment publik —
# membuka jalan SSRF ke jaringan internal.
# ALLOW_PRIVATE_ENDPOINTS=true

# Allowed CORS origins (comma-separated, production only)
ALLOWED_ORIGINS=https://prd-architect.example.com
