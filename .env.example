# PRD Architect — Environment Configuration
# Copy this file to .env and fill in your API keys.

# DeepSeek API Key (https://platform.deepseek.com)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Google Gemini API Key (https://aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenCode Zen API Key (https://opencode.ai) — provides free models
OPENCODE_API_KEY=your_opencode_api_key_here

# 9router API Key (https://9router.com) — router/proxy with custom endpoint & models
NINE_ROUTER_API_KEY=your_9router_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development

# Izinkan custom endpoint ke alamat privat/loopback (mis. proxy LLM lokal
# http://localhost:20128/v1/chat/completions). Otomatis aktif bila
# NODE_ENV != production. JANGAN aktifkan di deployment publik —
# membuka jalan SSRF ke jaringan internal.
# ALLOW_PRIVATE_ENDPOINTS=true

# Allowed CORS origins (comma-separated, production only)
ALLOWED_ORIGINS=https://prd-architect.example.com
